# =============================
# Backend (backend service)
# =============================
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:xKUBtsMtAqTvyaXgOVJQfQazFSZBJdTj@roundhouse.proxy.rlwy.net:19548/railway
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173

# Optional: disabled by default to avoid heavy startup jobs in production
ENABLE_STARTUP_BOTS=false
SEED_POPULAR_LIMIT=30
SEED_GENRE_LIMIT=20
SEED_IMPORT_CHAPTERS=true
SEED_REQUEST_DELAY_MS=400
STARTUP_GENRES=

# =============================
# Frontend (frontend service)
# =============================
# For local dev with Vite proxy you can keep this empty and use /api/v1.
VITE_API_BASE_URL=/api/v1
# Optional explicit socket URL. If omitted, it is inferred from VITE_API_BASE_URL/window origin.
VITE_SOCKET_URL=
# Optional for local dev proxy target (Vite dev server only)
VITE_DEV_API_PROXY_TARGET=http://localhost:3001