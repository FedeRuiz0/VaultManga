# =============================
# Backend (backend service)
# =============================
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Optional on Render (recommended if cache is needed)
REDIS_URL=
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173

# Optional: disabled by default to avoid heavy startup jobs in production
ENABLE_STARTUP_BOTS=false
SEED_POPULAR_LIMIT=30
SEED_GENRE_LIMIT=20
SEED_IMPORT_CHAPTERS=true
SEED_REQUEST_DELAY_MS=400
STARTUP_GENRES=

# =============================
# Frontend (frontend service)
# =============================
# Local dev: can stay as /api/v1 with Vite proxy.
VITE_API_BASE_URL=/api/v1
# Production (Vercel): set VITE_API_BASE_URL=https://<your-render-domain>/api/v1
# Optional explicit socket URL. If omitted, inferred from VITE_API_BASE_URL or window origin.
VITE_SOCKET_URL=
# Optional for local dev proxy target (Vite dev server only)
VITE_DEV_API_PROXY_TARGET=http://localhost:3001